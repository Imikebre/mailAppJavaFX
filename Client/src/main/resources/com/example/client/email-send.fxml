<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox style="-fx-background-color: #F5F5DC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="414.0" spacing="10">
         <children>
            <Region layoutX="76.0" layoutY="10.0" prefHeight="52.0" prefWidth="0.0" />
            <Label focusTraversable="false" text="OutBox" textFill="#733b73">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Region prefHeight="68.0" prefWidth="240.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendMail" prefHeight="14.0" prefWidth="41.0" style="-fx-background-color: #733b73; -fx-background-radius: 5;">
               <graphic>
                  <ImageView fitHeight="31.0" fitWidth="39.0" preserveRatio="true">
                     <image>
                        <Image url="@images/send-mail.png" />
                     </image>
                  </ImageView>
               </graphic>
               <tooltip>
                  <Tooltip text="Forward To" />
               </tooltip>
            </Button>
            <Region layoutX="10.0" layoutY="10.0" prefHeight="41.0" prefWidth="10.0" />
         </children>
      </HBox>
      <HBox prefHeight="35.0" prefWidth="409.0">
         <children>
            <Region prefHeight="41.0" prefWidth="10.0" />
            <Label focusTraversable="false" prefHeight="18.0" prefWidth="64.0" text="Recipients">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Region prefHeight="35.0" prefWidth="47.0" />
            <Region prefHeight="41.0" prefWidth="10.0" />
            <TextField fx:id="recipientsBox" prefHeight="26.0" prefWidth="267.0" promptText="insert recipients, seprated by a comma &quot;,&quot;" />
         </children>
      </HBox>
      <Region prefHeight="7.0" prefWidth="414.0" />
      <HBox prefHeight="22.0" prefWidth="414.0">
         <children>
            <Region prefHeight="26.0" prefWidth="6.0" />
            <Label prefHeight="17.0" prefWidth="50.0" style="-fx-alignment: center;" text="Subject" />
            <Region layoutX="10.0" layoutY="10.0" prefHeight="26.0" prefWidth="34.0" />
            <TextField fx:id="subjectBox" prefHeight="26.0" prefWidth="305.0" promptText="insert mail's subject" />
         </children>
      </HBox>
      <Region prefHeight="19.0" prefWidth="414.0" />
      <HBox>
         <children>
            <Region prefHeight="41.0" prefWidth="10.0" />
            <TextArea fx:id="bodyBox" prefHeight="249" prefWidth="393" style="-fx-border-color: #733B73;" wrapText="true" text="" />
            <Region prefHeight="41.0" prefWidth="10.0" />
         </children>
      </HBox>
      <Region prefHeight="19.0" prefWidth="414.0" />
      <Region prefHeight="19.0" prefWidth="414.0" />
   </children>
</VBox>
