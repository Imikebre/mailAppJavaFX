<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="370.0" prefWidth="240.0" spacing="10" style="-fx-background-color: #F5F5DC;" stylesheets="@styles/client-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.client.controller.ClientController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="MailBox" textFill="#733b73">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="sendMail" style="-fx-background-color: #733B73; -fx-background-radius: 5;" text="New Message" textFill="WHITE" />
    </HBox>
   <StackPane prefHeight="229.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
      <children>
      
          <!-- MAIL LIST -->
          <ListView fx:id="listView" prefHeight="191.0" prefWidth="200.0">

    </ListView>
         <Label fx:id="emptyLabel" prefHeight="17.0" prefWidth="118.0" text="Seems quiet here ..." textAlignment="CENTER" />
      </children>
   </StackPane>
   <Region prefHeight="10.0" prefWidth="200.0" />

    <!-- USER EMAIL -->
    <Label fx:id="mailfield" prefHeight="17.0" prefWidth="194.0" textAlignment="CENTER" textFill="#733b73" />

</VBox>
