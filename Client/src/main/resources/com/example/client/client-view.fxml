<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER"
      spacing="10"
      style="-fx-background-color: #F5F5DC;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.client.controller.ClientController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="MailBox" textFill="#733b73">
            <font>
                <Font name="System Bold" size="16"/>
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="New Message"
                textFill="WHITE"
                style="-fx-background-color: #733B73; -fx-background-radius: 5;"/>
    </HBox>

    <!-- MAIL LIST -->
    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: white;">
        <VBox fx:id="mailListContainer" spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </ScrollPane>

    <!-- USER EMAIL -->
    <Label fx:id="mailfield" textFill="#733b73"/>

    <!-- ERROR MESSAGE -->
    <Label fx:id="errorLabel"
           text="Insert a valid mail address"
           textFill="red"
           visible="false"
           managed="false"/>

</VBox>
