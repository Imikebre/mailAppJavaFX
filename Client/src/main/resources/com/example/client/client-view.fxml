<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox stylesheets="@styles/client-view.css" alignment="TOP_CENTER" spacing="10" style="-fx-background-color: #F5F5DC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.client.controller.ClientController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="MailBox" textFill="#733b73">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="sendMail" style="-fx-background-color: #733B73; -fx-background-radius: 5;" text="New Message" textFill="WHITE"  />
    </HBox>

    <!-- MAIL LIST -->
    <ListView fx:id="listView" VBox.vgrow="ALWAYS" >

    </ListView>

    <!-- USER EMAIL -->
    <Label fx:id="mailfield" textFill="#733b73" />

    <!-- ERROR MESSAGE -->
    <Label fx:id="errorLabel" managed="false" text="Insert a valid mail address" textFill="red" visible="false" />

</VBox>
