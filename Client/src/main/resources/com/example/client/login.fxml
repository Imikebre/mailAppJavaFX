<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="10" style="-fx-background-color: #F5F5DC;" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.client.controller.LoginController">
   <padding>
      <Insets bottom="20" left="20" right="20" top="20" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10">
         <children>
            <Label fx:id="textLabel" prefHeight="20.0" prefWidth="173.0" text="Insert a valid mail address" textAlignment="CENTER" textFill="#733b73">
               <font>
                  <Font name="System Bold" size="16" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Region layoutX="191.0" layoutY="10.0" />
         </children>
      </HBox>
      <TextField fx:id="loginMail" text="michele.brescia@edu.unito.it"/>
      <Button fx:id="loginButton"  style="-fx-background-color: #733B73; -fx-background-radius: 5;" text="Login" textFill="WHITE" onAction="#onLogin"/>
   </children>
</VBox>
