<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="176.0" prefWidth="280.0" spacing="20.0" style="-fx-background-color: #1E2A3A;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.server.ServerController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
   <children>
      <HBox fillHeight="false" prefHeight="39.0" prefWidth="186.0">
         <children>
            <Label maxHeight="29.0" text="Server Log " textFill="#2ecc71">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Region prefHeight="29.0" prefWidth="42.0" HBox.hgrow="ALWAYS" />
            <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/user.png" />
               </image>
            </ImageView>
            <Region prefHeight="29.0" prefWidth="5.0" />
            <Label fx:id="usersRegistered" text="5" textAlignment="CENTER" textFill="#2ecc71" />
         </children>
      </HBox>
      <TextArea fx:id="console" editable="false" prefHeight="200.0" prefWidth="200.0" style="-fx-border-color: #2ECC71; -fx-border-width: 1px;" wrapText="true" VBox.vgrow="ALWAYS" />
       <HBox prefWidth="200.0" VBox.vgrow="NEVER">
         <children>
            <Button mnemonicParsing="false" onAction="#showMailPrompt" prefHeight="18.0" prefWidth="33.0" style="-fx-background-color: #1E2A3A;">
               <graphic>
                  <ImageView fitHeight="16.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/add-user.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Region prefHeight="26.0" prefWidth="28.0" HBox.hgrow="ALWAYS" />
            <Button onAction="#clearView" prefHeight="26.0" prefWidth="46.0" style="-fx-background-color: #2ecc71;" text="Clear" textFill="#1e2a3a" />
            <Region layoutX="42.0" layoutY="10.0" prefHeight="26.0" prefWidth="15.0" HBox.hgrow="ALWAYS" />
            <ToggleButton fx:id="toggle" mnemonicParsing="false" style="-fx-background-color: #2ecc71;" text="Shutdown" textFill="#1e2a3a" />
         </children>
      </HBox>
      <TextField fx:id="userMail" managed="false" prefHeight="18.0" prefWidth="186.0" promptText="Insert a new mail here" style="-fx-border-color: #2ECC71;" visible="false" VBox.vgrow="NEVER" />
      <Button fx:id="userAdd" managed="false" mnemonicParsing="false" onAction="#addUser" style="-fx-background-color: #2ecc71;" text="Add" textFill="#1e2a3a" visible="false" VBox.vgrow="NEVER" />
   </children>
</VBox>
